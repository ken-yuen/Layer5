% ============================================================
% 弦律 ChordLaw — 規則檔 v0.4 (32 則錯誤規則 E01–E32)
% 仿照 Rust 借用/生命週期之簡化規則集
% 純 Datalog: 正遞迴 + 分層否定 (stratified)
% 內建: neq(A,B), path_conflict(A,B) (路徑相等或字段前綴),
%       covers(A,B) (寫 A 重新初始化 B: A==B 或 A 覆蓋 B),
%       subpath(A,B) (A 嚴格深於 B)
% 慣例: 變數大寫/_ 開頭; 常數小寫開頭 (陳述 s1…, 作用域 n0…, 路徑 x / x.f)
% ============================================================

% ---------- 結構: 控制流達達性 / 作用域樹 ----------
reach(A,B) :- edge(A,B).
reach(A,A) :- stmt(A).
reach(A,C) :- reach(A,B), edge(B,C).
% after = 控制流上嚴格在前 (DAG+後向邊; 排除自身)
after(A,B) :- reach(A,B), neq(A,B).

anc(N,M) :- parent(N,M).
anc(N,M) :- anc(N,K), parent(K,M).
inside(N,M) :- anc(N,M).
inside(N,M) :- same(N,M).

% ---------- 名稱: 別名鏈 (alias chain) ----------
ref_of(T,P) :- borrow_of(T,P).
ref_of(T,P) :- borrow_of(T,Q), ref_of(Q,P).

% ---------- 使用 (字段路徑感知: 整體/子字段存取皆算對該路徑之使用) ----------
% 任何存取 (讀/寫/經參考) 與被借者 P 路徑衝突
usep(S,P) :- read(S,P2), path_conflict(P,P2).
usep(S,P) :- write(S,P2), path_conflict(P,P2).
usep(S,P) :- use_ref(S,T), ref_of(T,R), path_conflict(R,P).
% 讀取性使用 (排除寫入; 寫入 = 重新初始化, 非「使用」)
readp(S,P) :- read(S,P2), path_conflict(P,P2).
readp(S,P) :- use_ref(S,T), ref_of(T,R), path_conflict(R,P).
% 讀取存了參考的槽 = 使用其被借者 (使 E04 能看見「經槽逸出後的使用」)
usep(S,P) :- read(S,Slot), store(_,Slot,T), ref_of(T,P).
readp(S,P) :- read(S,Slot), store(_,Slot,T), ref_of(T,P).

% ---------- 區域 (region): NLL 向前閉包 ----------
% 借貸 L 於點 Q 活躍: Q 位於「出借點 → 終端使用點」之某路徑上
% (span_end 由 liveness 檔定義: nll / referent / lexical 三種等級)
onregion(L,Q) :- lend(L,_,T,_), span_end(L,T,E), reach(L,Q), reach(Q,E).
% 同一(路徑衝突之)被借者之兩借貸重疊: 其一出借點落在另一之區域內
overlap(L1,L2,P1) :- lend(L1,P1,T1,_), lend(L2,P2,T2,_), neq(L1,L2), path_conflict(P1,P2), onregion(L1,L2).
overlap(L1,L2,P1) :- lend(L1,P1,T1,_), lend(L2,P2,T2,_), neq(L1,L2), path_conflict(P1,P2), onregion(L2,L1).
% 重新初始化: move/drop (D) 與使用 (S) 之間 (含 S 自身) 存在對 P 之覆蓋寫入
reinited(D,S,P) :- write(S,P2), covers(P2,P), after(D,S).
reinited(D,S,P) :- write(W,P2), after(D,W), after(W,S), covers(P2,P).
% 洞 (hole) 已初始化: S 之前 (含 S) 有覆蓋寫入
inited(S,P) :- write(S,P2), covers(P2,P).
inited(S,P) :- write(W,P2), after(W,S), covers(P2,P).

% ---------- 錯誤 E01–E10 (v0.3 核心, 不變) ----------
% E01 紅弧交越: 路徑衝突之兩借用重疊, 至少一者為 mut        (~ rustc E0499/E0502)
eclash(S) :- lend(A,P1,_,mut), lend(S,P2,T2,_), after(A,S), overlap(A,S,P1).
eclash(S) :- lend(A,P1,T1,_), lend(S,P2,_,mut), after(A,S), overlap(A,S,P1).

% E02 借用活躍期間寫入被借者 (含子字段)                     (~ rustc E0506)
ewrite(S) :- write(S,P), onregion(L,S), lend(L,R,T,_), path_conflict(R,P).

% E03 mut 借用活躍期間直接讀取被借者 (含子字段)             (~ rustc E0503)
eread(S) :- read(S,P), onregion(L,S), lend(L,R,T,mut), path_conflict(R,P).

% E04 使用點落在被借者作用域之外 (深度防禦)                 (~ rustc E0597)
edangle(S) :- usep(S,P), stmt_of(S,N), scope_of(P,M), !inside(N,M).

% E05 drop 後之讀取性使用 (寫入 = 重新初始化, 不犯)
eadrop(S) :- readp(S,P1), drop(D,P2), after(D,S), path_conflict(P1,P2), !reinited(D,S,P2).

% E06 move 後之使用 (含: 整體 move 後讀/寫子字段, 字段 move 後讀整體) (~ rustc E0382)
emove(S) :- readp(S,P1), move(D,P2), after(D,S), path_conflict(P1,P2), !reinited(D,S,P2).
emove(S) :- write(S,P1), move(D,P2), after(D,S), path_conflict(P1,P2), !reinited(D,S,P2).

% E07 借用活躍期間 move 被借者 (含子字段)                   (~ rustc E0505)
eloanmove(S) :- move(S,P), onregion(L,S), lend(L,R,T,_), path_conflict(R,P).

% E08 借用活躍期間顯式 drop 被借者 (含子字段)
eloandrop(S) :- drop(S,P), onregion(L,S), lend(L,R,T,_), path_conflict(R,P).

% E09 別名層衝突: 參考 t 之使用點, t 自身被借用活躍        (~ rustc E0502/E0499 別名層)
%   a) t 被 mut 借用: 任何對 t 之使用皆衝突
erefuse(S) :- use_ref(S,T), onregion(M,S), lend(M,T,_,mut).
%   b) t 本身是 mut 參考 (排他使用), 而被 sh 借用活躍
erefuse(S) :- use_ref(S,T), lend(L,_,T,mut), onregion(M,S), lend(M,T,_,_), neq(M,L).

% E10 逸出: 回傳參考之被借者不活得比呼叫者 (ROOT) 久       (~ rustc E0106/E0515)
ereturn(S) :- ret(S,T), ref_of(T,P), scope_of(P,M), !same(M,@ROOT@), !temp(P).

% ---------- 錯誤 E11–E32 (v0.4 擴充; 新事實觸發, 不擾 E01–E10 語料) ----------
% E11 寫入不可變地方 (非參數、非子字段)                    (~ rustc E0384)
eimmut(S) :- write(S,P), imm(P), !param(P).

% E12 對不可變地方作 mut 出借 (非參數、非子字段)            (~ rustc E0596)
enotmut(S) :- lend(S,P,_,mut), imm(P), !param(P).

% E13 經共享參考寫入                                       (~ rustc E0594)
eassignsh(S) :- deref_write(S,T), lend(L,_,T,sh).

% E14 經參考移出 (move out of borrowed content)            (~ rustc E0507)
emoveout(S) :- deref_move(S,T), borrow_of(T,_).

% E15 暫存借用被非緊鄰陳述使用 (保守 E0716: 暫存不過句)
etemp(S) :- temp(P), lend(L,P,T,_), use_ref(S,T), after(L,S), !edge(L,S).

% E16 把指向非 ROOT 之參考存入槽 (逸出/懸垂)               (~ rustc E0521/E0597)
eescape(S) :- store(S,Slot,T), ref_of(T,P), scope_of(P,M), !same(M,@ROOT@), !path_conflict(P,Slot).

% E17 把指向暫存的參考存入槽                               (~ rustc E0716)
estoretemp(S) :- store(S,Slot,T), ref_of(T,P), temp(P).

% E18 if 分支內 move 後, 分支外使用 (可能已移)             (~ rustc E0382)
ebranchmove(S) :- move(D,P), readp(S,P1), after(D,S), path_conflict(P,P1), !reinited(D,S,P), stmt_of(D,N), if_scope(I), inside(N,I), stmt_of(S,M), !inside(M,I).
ebranchmove(S) :- move(D,P), write(S,P1), after(D,S), path_conflict(P,P1), !reinited(D,S,P), stmt_of(D,N), if_scope(I), inside(N,I), stmt_of(S,M), !inside(M,I).

% E19 重複 drop (無中間重初始化)
edoubledrop(S) :- drop(D,P1), drop(S,P2), after(D,S), path_conflict(P1,P2), !reinited(D,S,P1).

% E20 move 後再 drop (無中間重初始化)                      (~ rustc E0382)
edropmoved(S) :- move(D,P1), drop(S,P2), after(D,S), path_conflict(P1,P2), !reinited(D,S,P1).

% E21 存入造成別名環 (把指向槽自身的參考存回槽)
ealiascyc(S) :- store(S,Slot,T), ref_of(T,Q), path_conflict(Q,Slot).

% E22 寫入不可變地方之子字段                               (~ rustc E0594)
eimmfield(S) :- write(S,P), imm(R), !param(R), subpath(P,R).

% E23 對不可變地方之子字段作 mut 出借                      (~ rustc E0596)
enotmutfield(S) :- lend(S,P,_,mut), imm(R), !param(R), subpath(P,R).

% E24 else 分支內 move 後, 分支外使用                      (~ rustc E0382)
eelsejoin(S) :- move(D,P), readp(S,P1), after(D,S), path_conflict(P,P1), !reinited(D,S,P), stmt_of(D,N), else_scope(I), inside(N,I), stmt_of(S,M), !inside(M,I).
eelsejoin(S) :- move(D,P), write(S,P1), after(D,S), path_conflict(P,P1), !reinited(D,S,P), stmt_of(D,N), else_scope(I), inside(N,I), stmt_of(S,M), !inside(M,I).

% E25 呼叫讀取 mut 借用活躍之路徑                          (~ rustc E0503)
ecallmut(S) :- call(S,P), onregion(L,S), lend(L,R,_,mut), path_conflict(R,P).

% E26 呼叫消耗後再使用                                     (~ rustc E0382)
ecallmove(S) :- callmv(D,P2), readp(S,P1), after(D,S), path_conflict(P1,P2), !reinited(D,S,P2).
ecallmove(S) :- callmv(D,P2), write(S,P1), after(D,S), path_conflict(P1,P2), !reinited(D,S,P2).

% E27 借用活躍期間呼叫消耗被借者                           (~ rustc E0505)
ecalloan(S) :- callmv(S,P), onregion(L,S), lend(L,R,_,_), path_conflict(R,P).

% E28 回傳指向暫存的參考                                   (~ rustc E0515/E0716)
erettemp(S) :- ret(S,T), ref_of(T,P), temp(P).

% E29 使用尚未初始化的洞                                   (~ rustc E0381)
euninit(S) :- hole(P), readp(S,P1), path_conflict(P,P1), !inited(S,P).

% E30 移出/回傳尚未初始化的洞                              (~ rustc E0381)
euninitret(S) :- hole(P), move(S,P1), path_conflict(P,P1), !inited(S,P).

% E31 寫入不可變參數                                       (~ rustc E0594)
eparamimmut(S) :- write(S,P), imm(R), param(R), path_conflict(R,P).

% E32 對不可變參數作 mut 出借                              (~ rustc E0596)
eparamnotmut(S) :- lend(S,P,_,mut), imm(R), param(R), path_conflict(R,P).
